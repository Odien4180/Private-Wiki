{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://project-wiki/schemas/backlink.schema.json",
  "title": "Backlink index",
  "type": "object",
  "required": ["backlinks"],
  "properties": {
    "backlinks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target", "references"],
        "properties": {
          "target": { "type": "string" },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["documentPath", "line", "column", "linkTarget"],
              "properties": {
                "documentPath": { "type": "string" },
                "line": { "type": "integer", "minimum": 1 },
                "column": { "type": "integer", "minimum": 1 },
                "linkTarget": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
