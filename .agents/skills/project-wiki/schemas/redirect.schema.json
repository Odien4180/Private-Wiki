{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://project-wiki/schemas/redirect.schema.json",
  "title": "Redirect index",
  "type": "object",
  "required": ["redirects"],
  "properties": {
    "redirects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
