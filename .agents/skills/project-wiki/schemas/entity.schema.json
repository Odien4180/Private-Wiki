{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://project-wiki/schemas/entity.schema.json",
  "title": "Entity",
  "type": "object",
  "required": ["id", "type", "title"],
  "properties": {
    "id": { "type": "string", "description": "Stable, kebab-case identifier that survives reasonable refactoring." },
    "type": {
      "type": "string",
      "enum": [
        "project", "architecture", "system", "feature", "class", "struct", "enum", "interface",
        "service", "manager", "component", "scene", "prefab", "data",
        "config", "package", "external", "tool"
      ]
    },
    "title": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "sources": { "type": "array", "items": { "type": "string" } },
    "symbols": { "type": "array", "items": { "type": "string" } },
    "namespace": { "type": "string" },
    "members": { "type": "array", "items": { "type": "string" } },
    "attributes": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
