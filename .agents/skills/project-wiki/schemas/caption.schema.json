{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://project-wiki/schemas/caption.schema.json",
  "title": "Caption",
  "description": "Planned for Milestone 3 (caption / source-caption processing). Not yet produced by the engine.",
  "type": "object",
  "required": ["id", "text"],
  "properties": {
    "id": { "type": "string" },
    "text": { "type": "string" },
    "source": {
      "type": "object",
      "properties": {
        "file": { "type": "string" },
        "startLine": { "type": "integer" },
        "endLine": { "type": "integer" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
